# Local development settings (Docker users: see docker-compose.example.yml).
# Everything else is configured in the app under Settings.

# Where the database, staging area and quarantine live
CALLIOPE_DATA_DIR=./data

# Seed defaults for the setup screen
MUSIC_DIR=./data/music
STAGING_DIR=./data/staging

# Optional: skip the setup screen by providing the first password
# CALLIOPE_PASSWORD=

# Optional: old Calliope database to import (Settings › Account & data)
# LEGACY_DB=/path/to/calliope.db
