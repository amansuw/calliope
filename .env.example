# Calliope Environment Variables
# Copy this file to .env and fill in your values

# =====================
# Core Configuration
# =====================

# Database location (default: ./calliope.db)
# DATABASE_URL=file:./calliope.db

# Temporary download directory (default: ./downloads)
# TEMP_DOWNLOAD_DIR=./downloads

# Music library directory (default: ./music)
# MUSIC_LIBRARY_DIR=./music

# =====================
# Download Format Defaults
# =====================

# Default audio format: mp3, opus, or flac
# DEFAULT_FORMAT=mp3

# Default audio quality (for mp3/opus): 128, 192, 256, or 320 kbps
# DEFAULT_QUALITY=320

# =====================
# Optional Integrations
# =====================

# Discord Notifications (optional)
# DISCORD_BOT_TOKEN=
# DISCORD_CHANNEL_ID=

# Navidrome Media Server (optional)
# NAVIDROME_URL=
# NAVIDROME_USER=
# NAVIDROME_PASSWORD=

# =====================
# Advanced Options
# =====================

# Spotify scraper command (optional, requires spotify-scraper package)
# SPOTIFY_SCRAPER_CMD=spotify-scraper

# YouTube cookies for age-restricted content (optional)
# Use one of the following:
# YTDLP_COOKIES_FROM_BROWSER=firefox
# YTDLP_COOKIES_FILE=/path/to/cookies.txt